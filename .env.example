# Copy this file to .env.local and fill in the two values from your Supabase
# project: Dashboard > Project Settings > API Keys (and Data API for the URL).
# These are safe to expose in the browser: Row Level Security protects the data.
# Never put the "secret" / service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Shows "Sign in with an email code" as a backup to Google.
# Only turn this on after setting up an email sender in Supabase
# (see README: "If Google sign-in fails on iPhone").
# VITE_ENABLE_EMAIL_CODE=true
